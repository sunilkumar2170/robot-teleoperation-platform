# Teleop-Sim Environment Configuration
# Host & Port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./data/teleop_sim.db

# Robot Simulation Settings
SIMULATION_FREQUENCY_HZ=20
ROBOT_DEFAULT_LINEAR_SPEED=1.0
ROBOT_DEFAULT_ANGULAR_SPEED=1.5
BOUNDS_MIN_X=-50.0
BOUNDS_MAX_X=50.0
BOUNDS_MIN_Y=-50.0
BOUNDS_MAX_Y=50.0

# Safety & Watchdog Settings
WATCHDOG_TIMEOUT_SECONDS=2.0
EMERGENCY_STOP_LOCKOUT=true

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Network Simulation Defaults
DEFAULT_LATENCY_MS=0
DEFAULT_JITTER_MS=0
DEFAULT_PACKET_LOSS_PCT=0.0
